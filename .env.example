# ─── Database ───────────────────────────────────────────────────────
# Local dev (PostgreSQL 18 via Docker — see docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/undercover_dev"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/undercover_dev"
# Production (Neon PostgreSQL): use the pooled URL for DATABASE_URL
# and the direct (non-pooled) URL for DIRECT_URL.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/db?sslmode=require&channel_binding=require"
# DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/db?sslmode=require&channel_binding=require"

# ─── Auth.js v5 (next-auth@beta) ────────────────────────────────────
# Generate with:  npx auth secret   (or:  openssl rand -base64 32)
AUTH_SECRET=""

# Google OAuth credentials — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:
#   dev:  http://localhost:3000/api/auth/callback/google
#   prod: https://YOUR-DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional — only set if you deploy behind a proxy / non-default URL
# AUTH_URL="http://localhost:3000"
# AUTH_TRUST_HOST="true"
